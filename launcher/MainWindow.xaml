<Window x:Class="LexCityLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lex City RP Launcher" Width="1000" Height="620" MinWidth="850" MinHeight="540" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Discord" Click="Discord_Click" Margin="6" Padding="16,9"/><Button Content="Configurações" Click="Settings_Click" Margin="6" Padding="16,9"/></StackPanel><StackPanel><TextBlock Text="LEX CITY RP" FontSize="34" FontWeight="Bold"><TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EC4899"/><GradientStop Color="#8B5CF6" Offset="1"/></LinearGradientBrush></TextBlock.Foreground></TextBlock><TextBlock Text="ROLEPLAY LAUNCHER" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="22" Padding="32" Margin="0,0,16,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Entre na cidade." FontSize="44" FontWeight="Bold"/><TextBlock Text="Seu próximo RP começa aqui." FontSize="20" Foreground="{StaticResource Muted}" Margin="0,8,0,26"/><Border Background="#090910" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="STATUS DO SERVIDOR" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Online" FontSize="18"/><TextBlock x:Name="PlayersText" Text="  •  127.0.0.1:7777" Foreground="{StaticResource Muted}" FontSize="16"/></StackPanel></StackPanel></Border><TextBlock Text="Nick" Foreground="{StaticResource Muted}" Margin="0,22,0,6"/><TextBox x:Name="NickBox" Height="42" Padding="12" Background="#090910" Foreground="White" BorderThickness="0"/><Button Content="▶  JOGAR AGORA" Height="54" Margin="0,22,0,0" Background="{StaticResource Purple}" Foreground="White" FontSize="18" FontWeight="Bold" Click="Play_Click"/><TextBlock x:Name="MessageText" Text="Pronto para iniciar." Foreground="{StaticResource Muted}" Margin="2,10,0,0"/></StackPanel></Border><StackPanel Grid.Column="1"><Border Background="{StaticResource Panel}" CornerRadius="22" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="LEX CITY RP" FontSize="22" FontWeight="Bold"/><TextBlock Text="Bem-vindo à cidade." FontSize="17" Margin="0,14,0,5"/><TextBlock Text="Launcher oficial do servidor. Mantenha seus arquivos atualizados para entrar no RP." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="22" Padding="24"><StackPanel><TextBlock Text="ATUALIZAÇÃO" FontSize="18" FontWeight="Bold"/><ProgressBar x:Name="UpdateProgress" Height="8" Margin="0,16,0,8" Minimum="0" Maximum="100"/><TextBlock x:Name="UpdateText" Text="Arquivos locais prontos." Foreground="{StaticResource Muted}"/><Button Content="Verificar arquivos" Click="Verify_Click" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></Grid></Grid><TextBlock Grid.Row="2" Text="Lex City RP • Launcher 1.0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,18,0,0"/></Grid></Window>
